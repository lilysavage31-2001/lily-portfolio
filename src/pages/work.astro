---
import Layout from '../layouts/Layout.astro';
import { fetchPortfolioProjects } from '../lib/cloudinary';
import type { ProjectMedia } from '../lib/cloudinary';

let items: ProjectMedia[] = [];
try {
  items = await fetchPortfolioProjects();
} catch (error) {
  console.error('Failed to fetch portfolio projects:', error);
}
---
<Layout title="Work — Lily Savage">
  <section class="work">
    <div class="work-grid">
      {items.map((item) => (
        <div class="grid-item">
          <img
            src={item.secure_url}
            alt={item.title || item.label}
            data-lightbox
            data-title={item.title}
            data-description={item.description}
          />
          <span class="item-label">{item.label}</span>
        </div>
      ))}
    </div>
  </section>
</Layout>

<style>
  .work {
    padding: 3.5rem 3rem 5rem;
  }

  .work-grid {
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    gap: 28px;
    align-items: start;
    width: 100%;
  }

  .grid-item {
    display: flex;
    flex-direction: column;
  }

  .grid-item img {
    width: 100%;
    height: auto;
    display: block;
    cursor: pointer;
  }

  .item-label {
    margin-top: 5px;
    font-size: 10px;
    font-weight: 100;
    letter-spacing: 0.04em;
    color: #000;
    opacity: 0.4;
  }

  @media (max-width: 768px) {
    .work {
      padding: 2.5rem 1.5rem 3.5rem;
    }

    .work-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  @media (max-width: 480px) {
    .work-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
</style>
