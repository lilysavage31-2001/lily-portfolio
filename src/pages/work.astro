---
import Layout from '../layouts/Layout.astro';
import { fetchCloudinaryMedia } from '../lib/cloudinary';
import type { CloudinaryMedia } from '../lib/cloudinary';

let media: CloudinaryMedia[] = [];
try {
  media = await fetchCloudinaryMedia();
} catch (error) {
  console.error('Failed to fetch Cloudinary media:', error);
}
---
<Layout title="Work — Lily Savage">
  <section class="work">
    <div class="work-grid">
      {media.map((item, i) => (
        <div class="grid-item">
          {item.resource_type === 'video' ? (
            <video
              src={item.secure_url}
              autoplay
              muted
              loop
              playsinline
              data-lightbox
              data-title={item.title}
              data-description={item.description}
            />
          ) : (
            <img
              src={item.secure_url}
              alt={item.title || `Project ${i + 1}`}
              data-lightbox
              data-title={item.title}
              data-description={item.description}
            />
          )}
        </div>
      ))}
    </div>

    <p class="project-label">Amelie Dupont</p>
  </section>
</Layout>

<style>
  .work {
    padding: 3.5rem 3rem 5rem;
  }

  .work-grid {
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    gap: 5px;
    align-items: start;
    width: 100%;
  }

  .grid-item img,
  .grid-item video {
    width: 100%;
    height: auto;
    display: block;
    cursor: pointer;
  }

  .project-label {
    text-align: center;
    margin-top: 2.5rem;
    font-size: 16px;
    font-weight: 200;
    letter-spacing: 0.04em;
  }

  @media (max-width: 768px) {
    .work {
      padding: 2.5rem 1.5rem 3.5rem;
    }

    .work-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  @media (max-width: 480px) {
    .work-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
</style>
