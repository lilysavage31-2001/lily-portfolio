---
import Layout from '../layouts/Layout.astro';

const cloudinaryImages = [
  "https://res.cloudinary.com/dmzxvx3in/image/upload/q_auto/f_auto/v1779679328/12_hree3m.jpg",
  "https://res.cloudinary.com/dmzxvx3in/image/upload/q_auto/f_auto/v1779679326/122_wl1sg0.jpg",
  "https://res.cloudinary.com/dmzxvx3in/image/upload/q_auto/f_auto/v1779679316/Sabrina_Socials-16_ozjkug.jpg",
  "https://res.cloudinary.com/dmzxvx3in/image/upload/q_auto/f_auto/v1779679288/Sabrina_Socials-11_fowbss.jpg",
  "https://res.cloudinary.com/dmzxvx3in/image/upload/q_auto/f_auto/v1779679189/aa_zmhui1.jpg",
  "https://res.cloudinary.com/dmzxvx3in/image/upload/q_auto/f_auto/v1779680373/mayacard_wbvn6y.jpg",
];
const images = Array.from({ length: 20 }, (_, i) => cloudinaryImages[i % 5]);
---
<Layout title="Work — Lily Savage">
  <section class="work">
    <div class="work-header">
      <h1>all projects</h1>
      <span class="rule">—</span>
    </div>

    <div class="work-grid">
      {images.map((src, i) => (
        <div class="grid-item">
          <img src={src} alt={`Project ${i + 1}`} data-lightbox />
        </div>
      ))}
    </div>

    <p class="project-label">Amelie Dupont</p>
  </section>
</Layout>

<style>
  .work {
    padding: 3.5rem 3rem 5rem;
  }

  .work-header {
    text-align: center;
    margin-bottom: 2.5rem;
  }

  h1 {
    font-size: 16px;
    font-weight: 200;
    letter-spacing: 0.06em;
    margin-bottom: 0.6rem;
  }

  .rule {
    display: block;
    font-size: 14px;
    font-weight: 200;
    opacity: 0.5;
    letter-spacing: 0.1em;
  }

  .work-grid {
    columns: 5;
    column-gap: 4px;
    width: 100%;
  }

  .grid-item {
    break-inside: avoid;
    margin-bottom: 4px;
  }

  .grid-item img {
    width: 100%;
    height: auto;
    cursor: pointer;
  }

  .project-label {
    text-align: center;
    margin-top: 2.5rem;
    font-size: 16px;
    font-weight: 200;
    letter-spacing: 0.04em;
  }

  @media (max-width: 768px) {
    .work {
      padding: 2.5rem 1.5rem 3.5rem;
    }

    .work-grid {
      columns: 3;
    }
  }

  @media (max-width: 480px) {
    .work-grid {
      columns: 2;
    }
  }
</style>
