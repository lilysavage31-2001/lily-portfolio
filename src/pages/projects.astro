---
import Layout from '../layouts/Layout.astro';
import { getProjectFolders, fetchProjectMedia } from '../lib/cloudinary';
import type { ProjectFolder, CloudinaryMedia } from '../lib/cloudinary';
import { projectData } from '../lib/projects';

let projects: ProjectFolder[] = [];
try {
  projects = await getProjectFolders();
} catch (error) {
  console.error('Failed to fetch project folders:', error);
}

// Swap in thumbnails set in projectData
const thumbnails = new Map<string, CloudinaryMedia>();
await Promise.all(
  projects.map(async (project) => {
    const name = projectData[project.id]?.thumbnail;
    if (!name) return;
    try {
      const match = (await fetchProjectMedia(project.id)).find((item) => item.public_id.includes(name));
      if (match) thumbnails.set(project.id, match);
    } catch (error) {
      console.error(`Failed to fetch thumbnail for project ${project.id}:`, error);
    }
  })
);
---
<Layout title="Projects — Lily Savage">
  <section class="projects">
    <div class="projects-grid">
      {projects.map((project) => {
        const thumb = thumbnails.get(project.id) ?? project.cover;
        const caption = project.cover?.title || projectData[project.id]?.name || '';
        return (
          <a href={`/project/${project.id}`} class="project-card">
            {thumb?.resource_type === 'video' ? (
              <video src={thumb.secure_url} autoplay muted loop playsinline />
            ) : thumb && (
              <img src={thumb.secure_url} alt={project.cover?.title || `Project ${project.id}`} />
            )}
            <span class="project-label">
              {caption.split('|').map((part) => (
                <span class="project-label-line">{part.trim()}</span>
              ))}
            </span>
          </a>
        );
      })}
    </div>
  </section>
</Layout>

<style>
  .projects {
    padding: 70px 1.5rem 2.5rem;
  }

  .projects-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 100px 20px;
    align-items: start;
    width: 100%;
  }

  .project-card {
    display: flex;
    flex-direction: column;
  }

  .project-card img,
  .project-card video {
    width: 100%;
    height: auto;
    display: block;
  }

  .project-label {
    margin-top: 6px;
    font-family: 'Helvetica Neue', Arial, sans-serif;
    font-size: 11px;
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.09px;
    line-height: 1.1;
    text-align: center;
    color: #000;
    opacity: 0.33;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .project-label-line {
    display: block;
  }

  .project-card:hover .project-label {
    opacity: 1;
  }

  @media (max-width: 768px) {
    .projects {
      padding: 70px 0.75rem 1.75rem;
    }

    .projects-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
</style>
