---
import Layout from '../../layouts/Layout.astro';
import { fetchProjectMedia } from '../../lib/cloudinary';
import type { CloudinaryMedia } from '../../lib/cloudinary';

const { id = '' } = Astro.params;

if (!/^[\w-]+$/.test(id)) {
  return new Response(null, { status: 404 });
}

// ─── PROJECT INFO ────────────────────────────────────────────────
// Edit each project's details here. The key is the folder number (id).
const projectData: Record<string, {
  name: string;
  client?: string;
  collaborators?: string;
  year?: string;
  deliverables?: string;
}> = {
  '9': {
    name: 'LOVE JAMES',
    client: 'Love James',
    collaborators: 'Photography by Katie Begbie\nModel: Ali Rodinciuc',
    year: '2026',
    deliverables: 'Art Direction',
  },
  '8': {
    name: 'ACTIVIST',
    client: 'Activist Mānuka Honey',
    collaborators: 'Completed as designer at Seachange Studio\nDevelopment done by MADE Studio',
    year: '2025',
    deliverables: 'Website design\nEDM templates\nSocial media templates',
  },
  '7': {
    name: 'WINNIE CATHERINE',
    client: 'Winnie Catherine',
    collaborators: 'Photography by Katie Begbie\nHMU by Josie Wignall\nModel: Sabrina Brunton',
    year: '2026',
    deliverables: 'Art Direction',
  },
  '6': {
    name: 'PATINA',
    client: 'Patina',
    collaborators: 'Photography by Katie Begbie\nModel: Ali Rodinciuc',
    year: '2026',
    deliverables: 'Art Direction',
  },
  '5': {
    name: 'LOVE JAMES',
    client: 'Love James',
    collaborators: 'Photography by Katie Begbie\nModel: Harper Sergeant',
    year: '2026',
    deliverables: 'Art Direction\nEditorial Design',
  },
  '4': {
    name: 'HOTEL DES ARTISTES',
    client: 'Hotel Des Artistes (Personal Project)',
    year: 'WIP',
    deliverables: 'Brand Identity\nPhotography',
  },
  '3': {
    name: 'UNDERLENA X FRAME HOTEL',
    client: 'Underlena\nFrame Hotel',
    year: '2026',
    deliverables: 'Art Direction\nGraphic Design',
  },
  '2': {
    name: 'FURTHER READING',
    client: 'Further Reading',
    year: 'WIP',
    deliverables: 'Brand Identity\nWebsite Design\nEditorial Design',
  },
};
// ─────────────────────────────────────────────────────────────────

let items: CloudinaryMedia[] = [];
try {
  items = await fetchProjectMedia(id);
} catch (error) {
  console.error(`Failed to fetch project ${id}:`, error);
}

if (items.length === 0) {
  return new Response(null, { status: 404 });
}

const info = projectData[id];
const cover = items.find((item) => item.resource_type === 'image') ?? items[0];
const projectName = info?.name || cover.title.split('|')[0].trim() || id;
---
<Layout title={`${projectName} — Lily Savage`} projectName={projectName} projectInfo={info}>
  <section class="project">
    <div class="project-media">
      {items.map((item) => (
        item.resource_type === 'video' ? (
          <video src={item.secure_url} autoplay muted loop playsinline />
        ) : (
          <img src={item.secure_url} alt={item.title || projectName} />
        )
      ))}
    </div>
  </section>
</Layout>

<style>
  .project {
    padding-top: 70px;
    background: #FAFAFA;
  }

  .project-media {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 300px;
    padding: 60px 40px 120px;
  }

  .project-media img,
  .project-media video {
    display: block;
    max-width: 100%;
    height: auto;
    max-height: 90vh;
    width: auto;
  }

  @media (max-width: 768px) {
    .project-media {
      gap: 40px;
      padding: 40px 20px 80px;
    }
  }
</style>
