---
import Layout from '../../layouts/Layout.astro';
import { fetchProjectMedia } from '../../lib/cloudinary';
import type { CloudinaryMedia } from '../../lib/cloudinary';
import { projectData } from '../../lib/projects';

const { id = '' } = Astro.params;

if (!/^[\w-]+$/.test(id)) {
  return new Response(null, { status: 404 });
}

let items: CloudinaryMedia[] = [];
try {
  items = await fetchProjectMedia(id);
} catch (error) {
  console.error(`Failed to fetch project ${id}:`, error);
}

if (items.length === 0) {
  return new Response(null, { status: 404 });
}

const info = projectData[id];
const cover = items.find((item) => item.resource_type === 'image') ?? items[0];
const projectName = info?.name || cover.title.split('|')[0].trim() || id;
const isHalfSize = (item: CloudinaryMedia) =>
  info?.halfSize?.some((name) => item.public_id.includes(name)) ?? false;
---
<Layout title={`${projectName} — Lily Savage`} projectName={projectName} projectInfo={info}>
  <section class="project">
    <div class="project-media">
      {items.map((item) => (
        item.resource_type === 'video' ? (
          <video src={item.secure_url} class:list={[{ half: isHalfSize(item) }]} autoplay muted loop playsinline />
        ) : (
          <img src={item.secure_url} class:list={[{ half: isHalfSize(item) }]} alt={item.title || projectName} />
        )
      ))}
    </div>
  </section>
</Layout>

<style>
  .project {
    padding-top: 70px;
    background: #FAFAFA;
  }

  .project-media {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 300px;
    padding: 60px 40px 120px;
  }

  .project-media img,
  .project-media video {
    display: block;
    max-width: 100%;
    height: auto;
    max-height: 90vh;
    width: auto;
  }

  .project-media .half {
    max-width: 50%;
    max-height: 45vh;
  }

  @media (max-width: 768px) {
    .project-media {
      gap: 40px;
      padding: 40px 20px 80px;
    }
  }
</style>
