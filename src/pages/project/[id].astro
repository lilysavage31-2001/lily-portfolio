---
import Layout from '../../layouts/Layout.astro';
import { fetchProjectMedia } from '../../lib/cloudinary';
import type { CloudinaryMedia } from '../../lib/cloudinary';

const { id = '' } = Astro.params;

if (!/^[\w-]+$/.test(id)) {
  return new Response(null, { status: 404 });
}

// ─── PROJECT INFO ────────────────────────────────────────────────
// Edit each project's details here. The key is the folder number (id).
const projectData: Record<string, {
  name: string;
  client?: string;
  collaborators?: string;
  year?: string;
  deliverables?: string;
}> = {
  '9': {
    name: 'Patina',
    client: 'Patina',
    collaborators: 'Photography by Katie Begbie\nModel: Ali Rodinciuc',
    year: '2026',
    deliverables: 'Art Direction',
  },
  // Add more projects below, e.g.:
  // '8': {
  //   name: 'Love James',
  //   client: 'Love James',
  //   collaborators: '',
  //   year: '2025',
  //   deliverables: 'Art Direction, Styling',
  // },
};
// ─────────────────────────────────────────────────────────────────

let items: CloudinaryMedia[] = [];
try {
  items = await fetchProjectMedia(id);
} catch (error) {
  console.error(`Failed to fetch project ${id}:`, error);
}

if (items.length === 0) {
  return new Response(null, { status: 404 });
}

const info = projectData[id];
const projectName = info?.name || id;
---
<Layout title={`${projectName} — Lily Savage`} projectName={projectName} projectInfo={info}>
  <section class="project">
    <div class="project-media">
      {items.map((item) => (
        item.resource_type === 'video' ? (
          <video src={item.secure_url} autoplay muted loop playsinline />
        ) : (
          <img src={item.secure_url} alt={item.title || projectName} />
        )
      ))}
    </div>
  </section>
</Layout>

<style>
  .project {
    padding-top: 70px;
    background: #FAFAFA;
  }

  .project-media {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 80px;
    padding: 60px 40px 120px;
  }

  .project-media img,
  .project-media video {
    display: block;
    max-width: 100%;
    height: auto;
    max-height: 90vh;
    width: auto;
  }

  @media (max-width: 768px) {
    .project-media {
      gap: 40px;
      padding: 40px 20px 80px;
    }
  }
</style>
