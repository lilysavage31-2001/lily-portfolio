---
import Layout from '../layouts/Layout.astro';
import { fetchCloudinaryImages } from '../lib/cloudinary';

const allImages = await fetchCloudinaryImages();
const heroImages = allImages.slice(0, 2);
---
<Layout title="Lily Savage">
  <section class="hero">
    <div class="hero-images">
      {heroImages.map((img, i) => (
        <img
          src={img.secure_url}
          alt={img.title || `Portfolio image ${i + 1}`}
          data-lightbox
          data-title={img.title}
          data-description={img.description}
        />
      ))}
    </div>
  </section>
</Layout>

<style>
  .hero {
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 4rem 3rem 5rem;
  }

  .hero-images {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.25rem;
    width: 88%;
    max-width: 1200px;
  }

  .hero-images img {
    width: 100%;
    height: auto;
    cursor: pointer;
  }

  @media (max-width: 768px) {
    .hero {
      padding: 2.5rem 1.5rem 3rem;
    }

    .hero-images {
      grid-template-columns: 1fr;
      width: 100%;
      gap: 1rem;
    }
  }

  @media (min-width: 769px) and (max-width: 1024px) {
    .hero-images {
      width: 94%;
    }
  }
</style>
