---
import { Image } from 'astro:assets';
import Layout from '../layouts/Layout.astro';

// Background images live in src/assets/home; the first two by filename fill the left and right halves
const homeImages = Object.entries(
  import.meta.glob<{ default: ImageMetadata }>('../assets/home/*.{jpg,jpeg,png,webp,avif}', { eager: true })
)
  .sort(([a], [b]) => a.localeCompare(b, undefined, { numeric: true }))
  .map(([, mod]) => mod.default);

const panels = homeImages.slice(0, 2);
---
<Layout title="Lily Savage" bare>
  <section class="hero">
    <div class="hero-panels">
      {panels.map((image) => (
        <div class="hero-panel">
          <Image
            src={image}
            alt=""
            widths={[720, 1080, 1440, 2160]}
            sizes="(max-width: 768px) 100vw, 50vw"
            loading="eager"
          />
        </div>
      ))}
    </div>

    <div class="hero-blur" id="hero-blur" aria-hidden="true"></div>

    <div class="intro-card">
      <div class="intro-text" id="intro-about">
        <p>I’m Lily. A <span class="nowrap">London-based</span> Graphic Designer and Art Director working across identity and visual storytelling.</p>
        <p>My approach is rooted in simplicity, restraint and craft. Building brand worlds that balance clarity and character and have a sense of&nbsp;permanence.</p>
      </div>

      <div class="contact-details" id="intro-contact" hidden>
        <p>
          <span class="contact-heading">Email</span>
          <a href="mailto:lilysavage31@gmail.com" class="contact-email">lilysavage31@gmail.com</a>
        </p>
        <p>
          <span class="contact-heading">London</span>
          <a href="tel:+44751639060">+44 7516 39060</a>
        </p>
        <p>
          <span class="contact-heading">New Zealand</span>
          <a href="tel:+642108184377">+64 210 8184377</a>
        </p>
        <p>From New Zealand.<br />Based in London.</p>
      </div>

      <div class="intro-links">
        <button type="button" class="tag" id="about-toggle" aria-controls="intro-about">About</button>
        <a href="/projects" class="tag">Selected Projects</a>
        <button type="button" class="tag" id="contact-toggle" aria-expanded="false" aria-controls="intro-contact">Contact</button>
      </div>
    </div>
  </section>
</Layout>

<script>
  // Contact swaps the card content in place and blurs the images behind it; About swaps back
  const aboutToggle = document.getElementById('about-toggle');
  const toggle = document.getElementById('contact-toggle');
  const about = document.getElementById('intro-about');
  const contact = document.getElementById('intro-contact');
  const blur = document.getElementById('hero-blur');

  function setContact(open: boolean) {
    toggle?.setAttribute('aria-expanded', String(open));
    toggle?.classList.toggle('tag--active', open);
    blur?.classList.toggle('open', open);
    if (about) about.hidden = open;
    if (contact) contact.hidden = !open;
  }

  toggle?.addEventListener('click', () => {
    setContact(toggle.getAttribute('aria-expanded') !== 'true');
  });
  aboutToggle?.addEventListener('click', () => setContact(false));
  blur?.addEventListener('click', () => setContact(false));
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') setContact(false);
  });
</script>

<style>
  .hero {
    position: relative;
    flex: 1;
    min-height: 100vh;
    min-height: 100dvh;
    display: flex;
    align-items: center;
    justify-content: center;
    background: #1a1a1a;
  }

  .hero-panels {
    position: absolute;
    inset: 0;
    display: flex;
  }

  .hero-panel {
    flex: 1 1 0;
    min-width: 0;
    overflow: hidden;
  }

  .hero-panel img {
    width: 100%;
    height: 100%;
    max-width: none;
    object-fit: cover;
    display: block;
  }

  .hero-blur {
    position: absolute;
    inset: 0;
    backdrop-filter: blur(30px);
    -webkit-backdrop-filter: blur(30px);
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.4s ease;
  }

  .hero-blur.open {
    opacity: 1;
    pointer-events: auto;
  }

  .intro-card {
    position: relative;
    z-index: 1;
    width: 372px;
    height: 268px;
    background: #fff;
    padding: 32px 27px 27px;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }

  .intro-text {
    display: flex;
    flex-direction: column;
    gap: 15.87px;
    font-family: 'Caslon Ionic', Georgia, serif;
    font-weight: 400;
    font-size: 14px;
    line-height: 1.05;
    letter-spacing: -0.01em;
    text-align: center;
    font-kerning: normal;
    text-rendering: optimizeLegibility;
  }

  .contact-details {
    margin-top: -3px;
    display: flex;
    flex-direction: column;
    gap: 18px;
    font-family: 'Caslon Ionic', Georgia, serif;
    font-weight: 400;
    font-size: 15px;
    line-height: 1;
    letter-spacing: -0.03em;
    text-align: center;
    font-kerning: normal;
    text-rendering: optimizeLegibility;
  }

  .contact-details[hidden],
  .intro-text[hidden] {
    display: none;
  }

  .contact-heading {
    display: block;
    font-family: 'Helvetica Neue', Arial, sans-serif;
    font-weight: 500;
    font-size: 12px;
    line-height: 1;
    letter-spacing: 0.12px;
    text-transform: uppercase;
  }

  .contact-details a:hover {
    opacity: 0.5;
  }

  .contact-email {
    text-decoration: underline;
    text-decoration-thickness: from-font;
    text-underline-position: from-font;
    text-decoration-skip-ink: none;
  }

  .nowrap {
    white-space: nowrap;
  }

  .intro-links {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    align-items: center;
    gap: 4px 1px;
    /* Reach into the card padding so all three tags fit on one row */
    margin: 0 -18px;
  }

  /* Label with pointed ends; on hover it flips to an outline */
  .tag {
    --point: 3.65px;
    --ink: #202020;
    --shape: polygon(
      var(--point) 0,
      calc(100% - var(--point)) 0,
      100% 50%,
      calc(100% - var(--point)) 100%,
      var(--point) 100%,
      0 50%
    );
    position: relative;
    isolation: isolate;
    display: inline-block;
    /* Offsets centre the cap height optically; the right side absorbs trailing letter-spacing */
    padding: 4.65px 11px 5.15px 11px;
    background: var(--ink);
    color: #fff;
    font-family: 'Caslon Ionic', Georgia, serif;
    font-weight: 400;
    font-size: 11px;
    line-height: 1;
    letter-spacing: 0.1em;
    /* Regular is the heaviest Caslon cut, so a hairline stroke adds weight without faux bold */
    -webkit-text-stroke: 0.55px currentColor;
    text-transform: uppercase;
    white-space: nowrap;
    border: none;
    cursor: pointer;
    clip-path: var(--shape);
  }

  /* White fill inset by 1px, leaving the dark edge showing as a stroke */
  .tag::before {
    content: '';
    position: absolute;
    inset: 1px;
    z-index: -1;
    background: #fff;
    clip-path: var(--shape);
    opacity: 0;
  }

  .tag:hover,
  .tag--active {
    color: var(--ink);
  }

  .tag:hover::before,
  .tag--active::before {
    opacity: 1;
  }

  @media (max-width: 768px) {
    .hero-panels {
      flex-direction: column;
    }

    .intro-card {
      width: calc(100% - 32px);
      max-width: 372px;
      height: auto;
      padding: 28px 20px 24px;
    }
  }
</style>
