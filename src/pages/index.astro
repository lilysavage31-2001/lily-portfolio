---
import Layout from '../layouts/Layout.astro';
import { fetchHeroMedia } from '../lib/cloudinary';
import type { CloudinaryMedia } from '../lib/cloudinary';

let heroItems: CloudinaryMedia[] = [];
try {
  heroItems = await fetchHeroMedia();
} catch (error) {
  console.error('Failed to fetch hero media:', error);
}
---
<Layout title="Lily Savage">
  <section class="hero">
    <div class="hero-items">
      {heroItems.map((item, i) => (
        item.resource_type === 'video' ? (
          <video
            src={item.secure_url}
            autoplay
            muted
            loop
            playsinline
            data-lightbox
            data-title={item.title}
            data-description={item.description}
          />
        ) : (
          <img
            src={item.secure_url}
            alt={item.title || `Portfolio image ${i + 1}`}
            data-lightbox
            data-title={item.title}
            data-description={item.description}
          />
        )
      ))}
    </div>
  </section>
</Layout>

<style>
  .hero {
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 4rem 1.5rem 5rem;
  }

  .hero-items {
    display: flex;
    gap: 1.25rem;
    width: 100%;
    max-width: 1400px;
    align-items: flex-start;
  }

  .hero-items img,
  .hero-items video {
    flex: 1 1 0;
    min-width: 0;
    width: 0;
    height: auto;
    cursor: pointer;
    display: block;
  }

  @media (max-width: 768px) {
    .hero {
      padding: 2.5rem 1.5rem 3rem;
    }

    .hero-items {
      flex-direction: column;
      gap: 1rem;
    }

    .hero-items img,
    .hero-items video {
      flex: none;
      width: 100%;
    }
  }
</style>
