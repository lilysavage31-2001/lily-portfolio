---
import Layout from '../layouts/Layout.astro';
import { fetchHeroImages } from '../lib/cloudinary';
import type { CloudinaryMedia } from '../lib/cloudinary';

let heroImages: CloudinaryMedia[] = [];
try {
  heroImages = await fetchHeroImages();
} catch (error) {
  console.error('Failed to fetch hero images:', error);
}
---
<Layout title="Lily Savage">
  <section class="hero">
    <div class="hero-images">
      {heroImages.map((img, i) => (
        <img
          src={img.secure_url}
          alt={img.title || `Portfolio image ${i + 1}`}
          data-lightbox
          data-title={img.title}
          data-description={img.description}
        />
      ))}
    </div>
  </section>
</Layout>

<style>
  .hero {
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 4rem 1.5rem 5rem;
  }

  .hero-images {
    display: flex;
    gap: 1.25rem;
    width: 100%;
    max-width: 1400px;
    align-items: flex-start;
  }

  .hero-images img {
    flex: 1 1 0;
    min-width: 0;
    width: 0;
    height: auto;
    cursor: pointer;
  }

  @media (max-width: 768px) {
    .hero {
      padding: 2.5rem 1.5rem 3rem;
    }

    .hero-images {
      flex-direction: column;
      gap: 1rem;
    }

    .hero-images img {
      flex: none;
      width: 100%;
    }
  }
</style>
