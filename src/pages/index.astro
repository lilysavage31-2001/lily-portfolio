---
import { Image } from 'astro:assets';
import Layout from '../layouts/Layout.astro';
import portraitBase from '../assets/about/portrait-base.png';
import portrait from '../assets/about/portrait.jpg';

// Background images live in src/assets/home; the first two by filename fill the left and right halves
const homeImages = Object.entries(
  import.meta.glob<{ default: ImageMetadata }>('../assets/home/*.{jpg,jpeg,png,webp,avif}', { eager: true })
)
  .sort(([a], [b]) => a.localeCompare(b, undefined, { numeric: true }))
  .map(([, mod]) => mod.default);

const panels = homeImages.slice(0, 2);
---
<Layout title="Lily Savage" bare>
  <section class="hero">
    <div class="hero-panels">
      {panels.map((image) => (
        <div class="hero-panel">
          <Image
            src={image}
            alt=""
            widths={[720, 1080, 1440, 2160]}
            sizes="(max-width: 768px) 100vw, 50vw"
            loading="eager"
          />
        </div>
      ))}
    </div>

    <div class="hero-blur" id="hero-blur" aria-hidden="true"></div>

    <div class="intro-card" id="intro-card" data-view="intro">
      <div class="intro-text" id="intro-about">
        <p>I’m Lily. A <span class="nowrap">London-based</span> Graphic Designer and Art Director working across identity and visual storytelling.</p>
        <p>My approach is rooted in simplicity, restraint and craft. Building brand worlds that balance clarity and character and have a sense of&nbsp;permanence.</p>
      </div>

      <div class="contact-details" id="intro-contact" hidden>
        <p>
          <span class="contact-heading">Email</span>
          <a href="mailto:lilysavage31@gmail.com" class="contact-email">lilysavage31@gmail.com</a>
        </p>
        <p>
          <span class="contact-heading">London</span>
          <a href="tel:+44751639060">+44 7516 39060</a>
        </p>
        <p>
          <span class="contact-heading">New Zealand</span>
          <a href="tel:+642108184377">+64 210 8184377</a>
        </p>
        <p>From New Zealand.<br />Based in London.</p>
      </div>

      <div class="about-panel" id="about-panel" hidden>
        <div class="about-bio">
          <p class="about-heading">About</p>
          <div class="about-copy">
            <p>I’m Lily, a London-based graphic designer and art director working across brand identity and visual storytelling. My approach is rooted in simplicity, restraint and craft, building brand worlds that balance clarity with character and have a sense of permanence.</p>
            <p>I began in UX/UI, which gave me a strong grounding in web and app design, before moving into brand identity at Seachange Studio. There I learnt the fundamentals of concept development, logo craft and packaging artworking, and started assisting on art direction, which I quickly came to love. I’m always exploring new tools across motion, 3D and web, which lets me push ideas further and brief specialist colleagues with a clear sense of what’s possible.</p>
            <p>For the past year I’ve worked freelance on identity projects for Previously Unavailable, Seachange and independent clients, and art directed shoots for fashion designers and retailers across New Zealand. Through this work I’m exploring how art direction, design and visual culture shape the way brands connect with their audiences, bringing photography, typography and cultural reference together across print, digital and social. I’m constantly engaged with fashion, lifestyle and culture through many mediums, which keeps my work relevant while staying true to timeless craft.</p>
            <p>After three years in Auckland, I’ve recently moved to London. Outside of work, I’m usually hunting for vintage fashion and homewares, or good coffee and wine bars. Old textiles, homewares and magazines are a constant source of inspiration, and one day I’d love to open my own boutique of curated vintage homewares, art and fashion.</p>
          </div>
        </div>

        <div class="about-services">
          <p class="about-heading">Services</p>
          <ul>
            <li>Concept Development</li>
            <li>Brand Identity</li>
            <li>Website Design</li>
            <li>Packaging Design</li>
            <li>Typography</li>
            <li>Editorial Design</li>
            <li>Art Direction</li>
          </ul>
        </div>

        <div class="about-portrait">
          <Image src={portraitBase} alt="" widths={[170, 340]} sizes="170px" class="about-portrait-base" />
          <div class="about-portrait-crop">
            <Image src={portrait} alt="Portrait of Lily Savage" widths={[248, 496]} sizes="248px" />
          </div>
        </div>
      </div>

      <div class="intro-links">
        <button type="button" class="tag" id="about-toggle" aria-expanded="false" aria-controls="about-panel">About</button>
        <a href="/projects" class="tag">Selected Projects</a>
        <button type="button" class="tag" id="contact-toggle" aria-expanded="false" aria-controls="intro-contact">Contact</button>
      </div>
    </div>
  </section>
</Layout>

<script>
  // About and Contact swap the card content in place and blur the images behind it
  type View = 'intro' | 'about' | 'contact';
  const card = document.getElementById('intro-card');
  const blur = document.getElementById('hero-blur');
  const panels: Record<View, HTMLElement | null> = {
    intro: document.getElementById('intro-about'),
    about: document.getElementById('about-panel'),
    contact: document.getElementById('intro-contact'),
  };
  const toggles: Partial<Record<View, HTMLElement | null>> = {
    about: document.getElementById('about-toggle'),
    contact: document.getElementById('contact-toggle'),
  };
  let current: View = 'intro';

  function setView(view: View) {
    current = view;
    if (card) card.dataset.view = view;
    for (const [name, panel] of Object.entries(panels)) {
      if (panel) panel.hidden = name !== view;
    }
    for (const [name, btn] of Object.entries(toggles)) {
      btn?.setAttribute('aria-expanded', String(name === view));
      btn?.classList.toggle('tag--active', name === view);
    }
    blur?.classList.toggle('open', view !== 'intro');
  }

  for (const [name, btn] of Object.entries(toggles) as [View, HTMLElement | null][]) {
    btn?.addEventListener('click', () => setView(current === name ? 'intro' : name));
  }
  blur?.addEventListener('click', () => setView('intro'));
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') setView('intro');
  });
</script>

<style>
  .hero {
    position: relative;
    flex: 1;
    min-height: 100vh;
    min-height: 100dvh;
    display: flex;
    align-items: center;
    justify-content: center;
    background: #1a1a1a;
  }

  .hero-panels {
    position: absolute;
    inset: 0;
    display: flex;
  }

  .hero-panel {
    flex: 1 1 0;
    min-width: 0;
    overflow: hidden;
  }

  .hero-panel img {
    width: 100%;
    height: 100%;
    max-width: none;
    object-fit: cover;
    display: block;
  }

  .hero-blur {
    position: absolute;
    inset: 0;
    backdrop-filter: blur(30px);
    -webkit-backdrop-filter: blur(30px);
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.4s ease;
  }

  .hero-blur.open {
    opacity: 1;
    pointer-events: auto;
  }

  .intro-card {
    position: relative;
    z-index: 1;
    width: 372px;
    height: 268px;
    background: #fff;
    padding: 32px 27px 27px;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }

  .intro-text {
    display: flex;
    flex-direction: column;
    gap: 15.87px;
    font-family: 'Caslon Ionic', Georgia, serif;
    font-weight: 400;
    font-size: 14px;
    line-height: 1.05;
    letter-spacing: -0.01em;
    text-align: center;
    font-kerning: normal;
    text-rendering: optimizeLegibility;
  }

  .contact-details {
    margin-top: -3px;
    display: flex;
    flex-direction: column;
    gap: 18px;
    font-family: 'Caslon Ionic', Georgia, serif;
    font-weight: 400;
    font-size: 15px;
    line-height: 1;
    letter-spacing: -0.03em;
    text-align: center;
    font-kerning: normal;
    text-rendering: optimizeLegibility;
  }

  .contact-details[hidden],
  .intro-text[hidden],
  .about-panel[hidden] {
    display: none;
  }

  /* About view: the card grows into a three-column layout with the tags pinned bottom right */
  .intro-card[data-view='about'] {
    display: block;
    width: 752px;
    height: auto;
    max-height: calc(100dvh - 32px);
    overflow-y: auto;
    padding: 10px;
  }

  .intro-card[data-view='about'] .intro-links {
    position: absolute;
    right: 10px;
    bottom: 10px;
    margin: 0;
  }

  .about-panel {
    display: grid;
    grid-template-columns: 343px 1fr 170px;
    color: #000;
  }

  .about-heading {
    font-family: 'Caslon Ionic', Georgia, serif;
    font-weight: 400;
    font-style: italic;
    font-size: 11px;
    line-height: 1.1;
    letter-spacing: -0.03em;
  }

  .about-copy,
  .about-services ul {
    font-size: 13px;
    line-height: 1.1;
  }

  .about-copy {
    margin-top: 10.9px;
    display: flex;
    flex-direction: column;
    gap: 12px;
    font-family: 'Helvetica Neue', Arial, sans-serif;
  }

  .about-services {
    padding-left: 29px;
  }

  .about-services ul {
    margin-top: 7.9px;
    padding: 0;
    list-style: none;
    font-family: 'Söhne', 'Helvetica Neue', Arial, sans-serif;
  }

  .about-portrait {
    position: relative;
    width: 170px;
    height: 253px;
    overflow: hidden;
  }

  .about-portrait img {
    position: absolute;
    max-width: none;
    display: block;
  }

  .about-portrait-base {
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .about-portrait-crop {
    position: absolute;
    inset: 0;
    overflow: hidden;
  }

  .about-portrait-crop img {
    width: 145.48%;
    height: 130.34%;
    left: -37.24%;
    top: -7.2%;
  }

  .contact-heading {
    display: block;
    font-family: 'Helvetica Neue', Arial, sans-serif;
    font-weight: 500;
    font-size: 12px;
    line-height: 1;
    letter-spacing: 0.12px;
    text-transform: uppercase;
  }

  .contact-details a:hover {
    opacity: 0.5;
  }

  .contact-email {
    text-decoration: underline;
    text-decoration-thickness: from-font;
    text-underline-position: from-font;
    text-decoration-skip-ink: none;
  }

  .nowrap {
    white-space: nowrap;
  }

  .intro-links {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    align-items: center;
    gap: 4px 1px;
  }

  /* Label with pointed ends; on hover it flips to an outline */
  .tag {
    --point: 3px;
    --ink: #202020;
    --shape: polygon(
      var(--point) 0,
      calc(100% - var(--point)) 0,
      100% 50%,
      calc(100% - var(--point)) 100%,
      var(--point) 100%,
      0 50%
    );
    position: relative;
    isolation: isolate;
    display: inline-block;
    /* Offsets centre the cap height optically; the right side absorbs trailing letter-spacing */
    padding: 3.8px 10px 4.2px 10px;
    background: var(--ink);
    color: #fff;
    font-family: 'Caslon Ionic', Georgia, serif;
    font-weight: 400;
    font-size: 9px;
    line-height: 1;
    letter-spacing: 0.1em;
    /* Regular is the heaviest Caslon cut, so a hairline stroke adds weight without faux bold */
    -webkit-text-stroke: 0.25px currentColor;
    text-transform: uppercase;
    white-space: nowrap;
    border: none;
    cursor: pointer;
    clip-path: var(--shape);
  }

  /* White fill inset by 1px, leaving the dark edge showing as a stroke */
  .tag::before {
    content: '';
    position: absolute;
    inset: 1px;
    z-index: -1;
    background: #fff;
    clip-path: var(--shape);
    opacity: 0;
  }

  .tag:hover,
  .tag--active {
    color: var(--ink);
  }

  .tag:hover::before,
  .tag--active::before {
    opacity: 1;
  }

  @media (max-width: 768px) {
    .hero-panels {
      flex-direction: column;
    }

    .intro-card {
      width: calc(100% - 32px);
      max-width: 372px;
      height: auto;
      padding: 28px 20px 24px;
    }

    .intro-card[data-view='about'] {
      width: calc(100% - 32px);
      max-width: 520px;
      padding: 16px;
    }

    .about-panel {
      grid-template-columns: 1fr;
      row-gap: 24px;
    }

    .about-services {
      padding-left: 0;
    }

    .intro-card[data-view='about'] .intro-links {
      position: static;
      margin-top: 24px;
    }
  }
</style>
