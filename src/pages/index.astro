---
import { Image } from 'astro:assets';
import Layout from '../layouts/Layout.astro';
import AboutPanel from '../components/AboutPanel.astro';

// Each half cycles through the images in its folder (src/assets/home/Left and Right), in filename order.
// Hovering a half shows its next image; on touch screens a tap does.
// Set to true to turn the image cycling back on. While false, each half shows only its first image.
const CYCLE_IMAGES = false;

// Shift an image's crop, keyed by folder/filename without extension.
// Negative x moves the visible area right (shows more of the image's right side); positive moves it left.
const cropShift: Record<string, { x?: number; y?: number }> = {
  'Left/1': { x: -60 },
};

type ImageGlob = Record<string, { default: ImageMetadata }>;
const inOrder = (glob: ImageGlob) =>
  Object.entries(glob)
    .sort(([a], [b]) => a.localeCompare(b, undefined, { numeric: true }))
    .map(([path, mod]) => {
      const key = path.split('/').slice(-2).join('/').replace(/\.[^.]+$/, '');
      const { x = 0, y = 0 } = cropShift[key] ?? {};
      return {
        image: mod.default,
        position: x || y ? `calc(50% + ${x}px) calc(50% + ${y}px)` : undefined,
      };
    });

const panels = [
  inOrder(import.meta.glob('../assets/home/Left/*.{jpg,jpeg,png,webp,avif}', { eager: true })),
  inOrder(import.meta.glob('../assets/home/Right/*.{jpg,jpeg,png,webp,avif}', { eager: true })),
].map((images) => (CYCLE_IMAGES ? images : images.slice(0, 1)));

// Images cover their half, so a wide image is shown wider than the half itself.
// Tell the browser the real displayed width so it picks a sharp enough file.
// Desktop halves are 50vw × 100vh; on phones they stack at 100vw × 50vh.
const sizesFor = (image: ImageMetadata) => {
  const aspect = (image.width / image.height).toFixed(3);
  return `(max-width: 768px) max(100vw, calc(50vh * ${aspect})), max(50vw, calc(100vh * ${aspect}))`;
};
---
<Layout title="Lily Savage" bare>
  <section class="hero">
    <div class="hero-panels">
      {panels.map((images) => (
        <div class="hero-panel" data-cycle>
          {images.map(({ image, position }, i) => (
            <Image
              src={image}
              alt=""
              widths={[720, 1080, 1440, 2160, 2880, 3840]}
              sizes={sizesFor(image)}
              style={position ? `object-position: ${position}` : undefined}
              quality={90}
              loading="eager"
              fetchpriority={i === 0 ? 'high' : 'low'}
              class={i === 0 ? 'is-active' : undefined}
            />
          ))}
        </div>
      ))}
    </div>

    <div class="hero-blur" id="hero-blur" aria-hidden="true"></div>

    <div class="intro-card" id="intro-card" data-view="intro">
      <div class="intro-text" id="intro-about">
        <p>Lily is a <span class="nowrap">London-based</span> Graphic Designer and Art Director working across fashion and lifestyle.</p>
        <p>Her approach is rooted in simplicity, restraint and craft. Building brand worlds that balance clarity and character, while carrying a sense of&nbsp;permanence.</p>
      </div>

      <div class="contact-details" id="intro-contact" hidden>
        <p>
          <span class="contact-heading">Email</span>
          <a href="mailto:lilysavage31@gmail.com" class="contact-email">lilysavage31@gmail.com</a>
        </p>
        <p>
          <span class="contact-heading">London</span>
          <a href="tel:+44751639060">+44 7516 39060</a>
        </p>
        <p>
          <span class="contact-heading">New Zealand</span>
          <a href="tel:+642108184377">+64 210 8184377</a>
        </p>
        <p>Born in New Zealand.<br />Based in London.</p>
      </div>

      <AboutPanel id="about-panel" hidden />

      <div class="intro-links">
        <button type="button" class="tag" id="about-toggle" aria-expanded="false" aria-controls="about-panel">About</button>
        <a href="/projects" class="tag">Selected Projects</a>
        <button type="button" class="tag" id="contact-toggle" aria-expanded="false" aria-controls="intro-contact">Contact</button>
      </div>
    </div>
  </section>
</Layout>

<script>
  // Hovering a half shows its next image; touch screens advance on tap instead.
  // The first hover on each half is ignored, so the opening images don't change the moment the cursor lands.
  document.querySelectorAll<HTMLElement>('[data-cycle]').forEach((panel) => {
    const images = [...panel.querySelectorAll('img')];
    if (images.length < 2) return;
    // Decode every image up front so swapping never shows a half-loaded frame
    const ready = images.map((img) => img.decode().catch(() => {}));
    let index = 0;
    let hovered = false;
    let pointerType = 'mouse';
    let switching = false;
    const next = async () => {
      if (switching) return;
      switching = true;
      const target = (index + 1) % images.length;
      await ready[target];
      images[index].classList.remove('is-active');
      images[target].classList.add('is-active');
      index = target;
      switching = false;
    };
    panel.addEventListener('pointerenter', (e) => {
      if (e.pointerType !== 'mouse') return;
      if (!hovered) {
        hovered = true;
        return;
      }
      next();
    });
    panel.addEventListener('pointerdown', (e) => {
      pointerType = e.pointerType;
    });
    panel.addEventListener('click', () => {
      if (pointerType !== 'mouse') next();
    });
  });

  // About and Contact swap the card content in place and blur the images behind it
  type View = 'intro' | 'about' | 'contact';
  const card = document.getElementById('intro-card');
  const blur = document.getElementById('hero-blur');
  const panels: Record<View, HTMLElement | null> = {
    intro: document.getElementById('intro-about'),
    about: document.getElementById('about-panel'),
    contact: document.getElementById('intro-contact'),
  };
  const toggles: Partial<Record<View, HTMLElement | null>> = {
    about: document.getElementById('about-toggle'),
    contact: document.getElementById('contact-toggle'),
  };
  let current: View = 'intro';

  function setView(view: View) {
    current = view;
    if (card) card.dataset.view = view;
    for (const [name, panel] of Object.entries(panels)) {
      if (panel) panel.hidden = name !== view;
    }
    for (const [name, btn] of Object.entries(toggles)) {
      btn?.setAttribute('aria-expanded', String(name === view));
      btn?.classList.toggle('tag--active', name === view);
    }
    blur?.classList.toggle('open', view !== 'intro');
  }

  for (const [name, btn] of Object.entries(toggles) as [View, HTMLElement | null][]) {
    btn?.addEventListener('click', () => setView(current === name ? 'intro' : name));
  }
  blur?.addEventListener('click', () => setView('intro'));
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') setView('intro');
  });
</script>

<style>
  .hero {
    position: relative;
    flex: 1;
    min-height: 100vh;
    min-height: 100dvh;
    display: flex;
    align-items: center;
    justify-content: center;
    background: #1a1a1a;
  }

  .hero-panels {
    position: absolute;
    inset: 0;
    display: flex;
  }

  .hero-panel {
    position: relative;
    flex: 1 1 0;
    min-width: 0;
    overflow: hidden;
  }

  /* Images stack in each half; only the active one shows */
  .hero-panel img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    max-width: none;
    object-fit: cover;
    display: block;
    opacity: 0;
  }

  .hero-panel img.is-active {
    opacity: 1;
  }

  .hero-blur {
    position: absolute;
    inset: 0;
    backdrop-filter: blur(30px);
    -webkit-backdrop-filter: blur(30px);
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.4s ease;
  }

  .hero-blur.open {
    opacity: 1;
    pointer-events: auto;
  }

  .intro-card {
    position: relative;
    z-index: 1;
    width: 372px;
    height: 268px;
    background: #fff;
    padding: 32px 27px 27px;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }

  .intro-text {
    display: flex;
    flex-direction: column;
    gap: 15.87px;
    font-family: 'Caslon Ionic', Georgia, serif;
    font-weight: 400;
    font-size: 14px;
    line-height: 1.2;
    letter-spacing: -0.01em;
    text-align: center;
    font-kerning: normal;
    text-rendering: optimizeLegibility;
  }

  .contact-details {
    margin-top: -3px;
    display: flex;
    flex-direction: column;
    gap: 18px;
    font-family: 'Caslon Ionic', Georgia, serif;
    font-weight: 400;
    font-size: 15px;
    line-height: 1.15;
    letter-spacing: -0.03em;
    text-align: center;
    font-kerning: normal;
    text-rendering: optimizeLegibility;
  }

  .contact-details[hidden],
  .intro-text[hidden] {
    display: none;
  }

  /* About view: the card grows into a three-column layout with the tags pinned bottom right */
  .intro-card[data-view='about'] {
    display: block;
    width: 752px;
    height: auto;
    max-height: calc(100dvh - 32px);
    overflow-y: auto;
    padding: 10px;
  }

  .intro-card[data-view='about'] .intro-links {
    position: absolute;
    right: 10px;
    bottom: 10px;
    margin: 0;
  }

  .contact-heading {
    display: block;
    font-family: 'Helvetica Neue', Arial, sans-serif;
    font-weight: 500;
    font-size: 12px;
    line-height: 1;
    letter-spacing: 0.12px;
    text-transform: uppercase;
  }

  .contact-details a:hover {
    opacity: 0.5;
  }

  .contact-email {
    text-decoration: underline;
    text-decoration-thickness: from-font;
    text-underline-position: from-font;
    text-decoration-skip-ink: none;
  }

  .nowrap {
    white-space: nowrap;
  }

  .intro-links {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    align-items: center;
    gap: 4px 1px;
  }

  /* Label with pointed ends; on hover it flips to an outline */
  .tag {
    --point: 3px;
    --ink: #202020;
    --shape: polygon(
      var(--point) 0,
      calc(100% - var(--point)) 0,
      100% 50%,
      calc(100% - var(--point)) 100%,
      var(--point) 100%,
      0 50%
    );
    position: relative;
    isolation: isolate;
    display: inline-block;
    /* Offsets centre the cap height optically; the right side absorbs trailing letter-spacing */
    padding: 3.5px 10px 4.2px 10px;
    background: var(--ink);
    color: #fff;
    /* Same face and weight as the project titles in the header */
    font-family: 'Helvetica Neue', Arial, sans-serif;
    font-weight: 500;
    font-size: 9px;
    line-height: 1;
    letter-spacing: 0.08em;
    /* Helvetica Neue jumps from medium to bold, so a hairline stroke adds a touch more weight */
    -webkit-text-stroke: 0.2px currentColor;
    text-transform: uppercase;
    white-space: nowrap;
    border: none;
    cursor: pointer;
    clip-path: var(--shape);
  }

  /* White fill inset by 1px, leaving the dark edge showing as a stroke */
  .tag::before {
    content: '';
    position: absolute;
    inset: 1px;
    z-index: -1;
    background: #fff;
    clip-path: var(--shape);
    opacity: 0;
  }

  .tag:hover,
  .tag--active {
    color: var(--ink);
  }

  .tag:hover::before,
  .tag--active::before {
    opacity: 1;
  }

  @media (max-width: 768px) {
    .hero-panels {
      flex-direction: column;
    }

    .intro-card {
      width: calc(100% - 32px);
      max-width: 372px;
      height: auto;
      padding: 28px 20px 24px;
    }

    .intro-card[data-view='about'] {
      width: calc(100% - 32px);
      max-width: 520px;
      padding: 16px;
    }

    .intro-card[data-view='about'] .intro-links {
      position: static;
      margin-top: 24px;
    }
  }
</style>
