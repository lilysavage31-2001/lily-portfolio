---
// About content shared by the home card's About view and the About overlay on other pages
import type { HTMLAttributes } from 'astro/types';
import { Image } from 'astro:assets';
import portrait from '../assets/about/portrait.jpg';

type Props = HTMLAttributes<'div'>;
const attrs = Astro.props;
---
<div class="about-panel" {...attrs}>
  <div class="about-bio">
    <p class="about-heading">About</p>
    <div class="about-copy">
      <p>I’m Lily, a London-based graphic designer and art director working across brand identity and visual storytelling. My approach is rooted in simplicity, restraint and craft, building brand worlds that balance clarity with character and have a sense of permanence.</p>
      <p>I have worked on identity projects for Previously Unavailable, Seachange and independent clients, and art directed shoots for fashion designers and retailers across New Zealand. Through this work I’m exploring how art direction, design and visual culture shape the way brands connect with their audiences, bringing photography, typography and cultural reference together across print, digital and social.</p>
      <p>Outside of work, I’m usually hunting for vintage fashion and homewares, or good coffee and wine bars. Textiles, homewares and magazines are a constant source of inspiration.</p>
    </div>
  </div>

  <div class="about-services">
    <p class="about-heading">Services</p>
    <ul>
      <li>Concept Development</li>
      <li>Art Direction</li>
      <li>Brand Identity</li>
      <li>Website Design</li>
      <li>Packaging Design</li>
      <li>Typography</li>
      <li>Editorial Design</li>
    </ul>
  </div>

  <div class="about-portrait">
    <div class="about-portrait-crop">
      <!-- Loads with the page (the panel starts hidden) so opening About never waits on it -->
      <Image src={portrait} alt="Portrait of Lily Savage" widths={[248, 496]} sizes="248px" loading="eager" decoding="sync" />
    </div>
  </div>
</div>

<style>
  .about-panel[hidden] {
    display: none;
  }

  .about-panel {
    display: grid;
    grid-template-columns: 343px 1fr 170px;
    color: #000;
  }

  .about-heading {
    font-family: 'Caslon Ionic', Georgia, serif;
    font-weight: 400;
    font-style: italic;
    font-size: 11px;
    line-height: 1.1;
    letter-spacing: -0.03em;
  }

  .about-copy,
  .about-services ul {
    font-size: 13px;
    line-height: 1.1;
  }

  .about-copy {
    margin-top: 10.9px;
    display: flex;
    flex-direction: column;
    gap: 12px;
    font-family: 'Helvetica Neue', Arial, sans-serif;
  }

  .about-services {
    padding-left: 29px;
  }

  .about-services ul {
    margin-top: 7.9px;
    padding: 0;
    list-style: none;
    font-family: 'Söhne', 'Helvetica Neue', Arial, sans-serif;
  }

  .about-portrait {
    position: relative;
    width: 170px;
    height: 253px;
    overflow: hidden;
  }

  .about-portrait img {
    position: absolute;
    max-width: none;
    display: block;
  }

  .about-portrait-crop {
    position: absolute;
    inset: 0;
    overflow: hidden;
  }

  .about-portrait-crop img {
    width: 145.48%;
    height: 130.34%;
    left: -37.24%;
    top: -7.2%;
  }

  @media (max-width: 768px) {
    .about-panel {
      grid-template-columns: 1fr;
      row-gap: 24px;
    }

    .about-services {
      padding-left: 0;
    }
  }
</style>
