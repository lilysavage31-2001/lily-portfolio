---
interface Props {
  title?: string;
  projectName?: string;
  projectDescription?: string;
}
const { title = "Lily Savage", projectName, projectDescription } = Astro.props;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <title>{title}</title>
  </head>
  <body>
    <nav>
      <a href="/" class="nav-logo">Lily Savage</a>
      <div class="nav-center">
        <a href="/projects" class="nav-link" id="nav-projects">Projects</a>
        {projectName && (
          <>
            <span class="nav-project-name">{projectName}</span>
            <button class="nav-link nav-info-btn" id="nav-info-btn">Project Information +</button>
          </>
        )}
      </div>
      <button class="nav-link nav-right" id="nav-contact-btn">Contact</button>
    </nav>

    <main>
      <slot />
    </main>

    <footer>
      <div class="footer-info">
        <p>Lily Savage is a graphic designer / art director / stylist</p>
        <p>Currently Based in New Zealand</p>
      </div>
      <div class="footer-links">
        <a href="mailto:hello@lilysavage.com">Email</a>
        <a href="https://instagram.com/lilysavage_" target="_blank" rel="noopener noreferrer">Instagram</a>
      </div>
    </footer>

    <div id="contact-overlay" class="contact-overlay">
      <button class="contact-close" id="contact-close">Close</button>
      <div class="contact-card">
        <div class="contact-row">
          <span class="contact-label">Email</span>
          <a href="mailto:lily@lilysavage.co" class="contact-value">lily@lilysavage.co</a>
        </div>
        <div class="contact-row">
          <span class="contact-label">Instagram</span>
          <a href="https://instagram.com/lilysavage_" target="_blank" rel="noopener noreferrer" class="contact-value">@lilysavage_</a>
        </div>
        <div class="contact-row">
          <span class="contact-label">Based</span>
          <span class="contact-value">New Zealand / London</span>
        </div>
      </div>
    </div>

    {projectDescription !== undefined && (
      <div id="info-overlay" class="info-overlay">
        <div class="info-overlay-content">
          {projectDescription ? (
            <p>{projectDescription}</p>
          ) : (
            <p style="opacity:0.33">No project information added yet.</p>
          )}
        </div>
      </div>
    )}

    <script>
      // Contact overlay
      const contactBtn = document.getElementById('nav-contact-btn');
      const contactOverlay = document.getElementById('contact-overlay');
      const contactClose = document.getElementById('contact-close');
      function openContact() {
        contactOverlay?.classList.add('open');
        document.body.style.overflow = 'hidden';
      }
      function closeContact() {
        contactOverlay?.classList.remove('open');
        document.body.style.overflow = '';
      }
      contactBtn?.addEventListener('click', openContact);
      contactClose?.addEventListener('click', closeContact);
      contactOverlay?.addEventListener('click', (e) => {
        if (e.target === contactOverlay) closeContact();
      });
      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape') closeContact();
      });

      // Info overlay
      const infoBtn = document.getElementById('nav-info-btn');
      const infoOverlay = document.getElementById('info-overlay');
      if (infoBtn && infoOverlay) {
        infoBtn.addEventListener('click', () => {
          infoOverlay.classList.toggle('open');
          document.body.style.overflow = infoOverlay.classList.contains('open') ? 'hidden' : '';
        });
        infoOverlay.addEventListener('click', (e) => {
          if (e.target === infoOverlay) {
            infoOverlay.classList.remove('open');
            document.body.style.overflow = '';
          }
        });
        document.addEventListener('keydown', (e) => {
          if (e.key === 'Escape') {
            infoOverlay.classList.remove('open');
            document.body.style.overflow = '';
          }
        });
      }
    </script>
  </body>
</html>

<style is:global>
  @font-face {
    font-family: 'Caslon Ionic';
    src: url('/fonts/CaslonIonic-Light-Trial.otf') format('opentype');
    font-weight: 300;
    font-style: normal;
    font-display: swap;
  }

  @font-face {
    font-family: 'Caslon Ionic';
    src: url('/fonts/CaslonIonic-LightItalic-Trial.otf') format('opentype');
    font-weight: 300;
    font-style: italic;
    font-display: swap;
  }

  @font-face {
    font-family: 'Caslon Ionic';
    src: url('/fonts/CaslonIonic-Regular-Trial.otf') format('opentype');
    font-weight: 400;
    font-style: normal;
    font-display: swap;
  }

  @font-face {
    font-family: 'Caslon Ionic';
    src: url('/fonts/CaslonIonic-RegularItalic-Trial.otf') format('opentype');
    font-weight: 400;
    font-style: italic;
    font-display: swap;
  }

  *, *::before, *::after {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
  }

  html {
    font-family: 'Helvetica Neue', Arial, sans-serif;
    font-weight: 400;
    font-size: 16px;
    background: #FAFAFA;
    color: #000000;
    -webkit-font-smoothing: antialiased;
  }

  body {
    min-height: 100vh;
    display: flex;
    flex-direction: column;
  }

  main {
    flex: 1;
  }

  a {
    color: #000000;
    text-decoration: none;
  }

  img {
    display: block;
    max-width: 100%;
  }

  /* ── NAV ── */
  nav {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    height: 50px;
    background: #FAFAFA;
    z-index: 100;
    display: flex;
    align-items: center;
  }

  .nav-logo {
    position: absolute;
    left: 20px;
    font-family: 'Helvetica Neue', Arial, sans-serif;
    font-size: 12px;
    font-weight: 700;
    color: #000;
    letter-spacing: 0.12px;
    text-decoration: none;
  }

  .nav-center {
    margin: 0 auto;
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .nav-link {
    font-family: 'Caslon Ionic', Georgia, serif;
    font-weight: 300;
    font-style: italic;
    font-size: 12px;
    color: #000;
    opacity: 0.33;
    letter-spacing: 0.36px;
    text-decoration: none;
    cursor: pointer;
    background: none;
    border: none;
    padding: 0;
  }

  .nav-link:hover {
    opacity: 1;
  }

  .nav-project-name {
    font-family: 'Helvetica Neue', Arial, sans-serif;
    font-size: 12px;
    font-weight: 700;
    color: #000;
    letter-spacing: 0.12px;
  }

  .nav-right {
    position: absolute;
    right: 20px;
    opacity: 0.33;
  }

  .nav-right:hover {
    opacity: 1;
  }

  /* ── FOOTER ── */
  footer {
    background: #FAFAFA;
    padding: 1.5rem;
    margin-top: auto;
    display: flex;
    flex-direction: column;
    gap: 2rem;
  }

  .footer-info {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  .footer-info p {
    font-size: 15px;
    font-weight: 400;
    letter-spacing: 0;
    line-height: 1.6;
  }

  .footer-links {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  .footer-links a {
    font-size: 15px;
    font-weight: 400;
    letter-spacing: 0;
  }

  /* ── CONTACT OVERLAY ── */
  .contact-overlay {
    display: none;
    position: fixed;
    inset: 0;
    background: rgba(250, 250, 250, 0.80);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    z-index: 300;
    align-items: center;
    justify-content: center;
  }

  .contact-overlay.open {
    display: flex;
  }

  .contact-close {
    position: absolute;
    top: 20px;
    right: 20px;
    font-family: 'Helvetica Neue', Arial, sans-serif;
    font-size: 12px;
    font-weight: 400;
    color: #000;
    background: none;
    border: none;
    cursor: pointer;
    padding: 0;
    letter-spacing: 0;
  }

  .contact-close:hover {
    opacity: 0.5;
  }

  .contact-card {
    display: flex;
    flex-direction: column;
    gap: 0;
    min-width: 280px;
  }

  .contact-row {
    display: flex;
    flex-direction: column;
    padding: 14px 0;
    border-bottom: 1px solid rgba(0,0,0,0.1);
  }

  .contact-row:first-child {
    border-top: 1px solid rgba(0,0,0,0.1);
  }

  .contact-label {
    font-family: 'Caslon Ionic', Georgia, serif;
    font-style: italic;
    font-weight: 300;
    font-size: 11px;
    color: #000;
    opacity: 0.5;
    margin-bottom: 2px;
  }

  .contact-value {
    font-family: 'Helvetica Neue', Arial, sans-serif;
    font-size: 14px;
    font-weight: 400;
    color: #000;
    text-decoration: none;
  }

  .contact-value:hover {
    opacity: 0.5;
  }

  /* ── INFO OVERLAY ── */
  .info-overlay {
    display: none;
    position: fixed;
    inset: 0;
    background: rgba(250, 250, 250, 0.97);
    z-index: 200;
    align-items: center;
    justify-content: center;
  }

  .info-overlay.open {
    display: flex;
  }

  .info-overlay-content {
    max-width: 600px;
    font-family: 'Helvetica Neue', Arial, sans-serif;
    font-size: 14px;
    line-height: 1.6;
    color: #000;
    text-align: center;
    padding: 40px;
  }

  /* ── RESPONSIVE ── */
  @media (max-width: 768px) {
    nav {
      padding: 0 16px;
    }

    .nav-logo {
      left: 16px;
    }

    .nav-right {
      right: 16px;
    }

    footer {
      padding: 1rem 0.75rem;
    }
  }
</style>
