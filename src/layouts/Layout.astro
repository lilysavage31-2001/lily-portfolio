---
interface ProjectInfo {
  name: string;
  client?: string;
  collaborators?: string;
  year?: string;
  deliverables?: string;
  brief?: string;
  solution?: string;
}

interface Props {
  title?: string;
  projectName?: string;
  projectInfo?: ProjectInfo;
}
const { title = "Lily Savage", projectName, projectInfo } = Astro.props;
// Every project page gets an info overlay, even without a projectData entry
const info: Partial<ProjectInfo> = projectInfo ?? {};
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <title>{title}</title>
  </head>
  <body>
    <nav>
      <a href="/" class="nav-logo">Lily Savage</a>
      <div class="nav-center">
        <a href="/projects" class="nav-link" id="nav-projects">Projects</a>
        {projectName && (
          <>
            <span class="nav-project-name">{projectName}</span>
            <button class="nav-link nav-info-btn" id="nav-info-btn">Project Information +</button>
          </>
        )}
      </div>
      <button class="nav-link nav-right" id="nav-contact-btn">Contact</button>
    </nav>

    <main>
      <slot />
    </main>

    <footer>
      {projectName ? (
        <a href="/projects" class="nav-link">Back to all projects</a>
      ) : (
        <div class="footer-info">
          <p>Lily is a Graphic Designer and Art Director building thoughtful brand worlds through considered typography, art direction and visual storytelling. My approach is rooted in simplicity, restraint and craft, creating identities that feel both timeless and contemporary.</p>
        </div>
      )}
    </footer>

    <div id="contact-overlay" class="contact-overlay">
      <button class="contact-close" id="contact-close">Close</button>
      <div class="contact-card">
        <div class="contact-item">
          <span class="contact-label">Email</span>
          <a href="mailto:lilysavage31@gmail.com" class="contact-value">lilysavage31@gmail.com</a>
        </div>
        <div class="contact-item">
          <span class="contact-label">London</span>
          <span class="contact-value">+44 7516 39060</span>
        </div>
        <div class="contact-item">
          <span class="contact-label">New Zealand</span>
          <span class="contact-value">+64 210 8184377</span>
        </div>
        <div class="contact-item">
          <span class="contact-label">Website</span>
          <a href="https://lilysavage.co" class="contact-value">lilysavage.co</a>
        </div>
        <div class="contact-based">
          <span class="contact-value">Based in London,<br />Available world wide</span>
        </div>
      </div>
    </div>

    {projectName && (
      <div id="info-overlay" class="info-overlay">
        <button class="info-close" id="info-close">Close</button>
        <div class="info-card">
          {info.client && (
            <div class="info-section">
              <span class="info-label">Client</span>
              <span class="info-value">{info.client}</span>
            </div>
          )}
          {info.collaborators && (
            <div class="info-section">
              <span class="info-label">Collaborators</span>
              <span class="info-value info-value--pre">{info.collaborators}</span>
            </div>
          )}
          {info.year && (
            <div class="info-section">
              <span class="info-label">Year</span>
              <span class="info-value">{info.year}</span>
            </div>
          )}
          {info.deliverables && (
            <div class="info-section">
              <span class="info-label">Deliverables</span>
              <span class="info-value info-value--pre">{info.deliverables}</span>
            </div>
          )}
          {info.brief && (
            <div class="info-section">
              <span class="info-label">Brief</span>
              <span class="info-value">{info.brief}</span>
            </div>
          )}
          {info.solution && (
            <div class="info-section">
              <span class="info-label">Solution</span>
              <span class="info-value">{info.solution}</span>
            </div>
          )}
          {!info.client && !info.collaborators && !info.year && !info.deliverables && !info.brief && !info.solution && (
            <p class="info-empty">No project information added yet.</p>
          )}
        </div>
      </div>
    )}

    <script>
      // Contact overlay
      const contactBtn = document.getElementById('nav-contact-btn');
      const contactOverlay = document.getElementById('contact-overlay');
      const contactClose = document.getElementById('contact-close');
      function openContact() {
        contactOverlay?.classList.add('open');
        document.body.style.overflow = 'hidden';
      }
      function closeContact() {
        contactOverlay?.classList.remove('open');
        document.body.style.overflow = '';
      }
      contactBtn?.addEventListener('click', openContact);
      contactClose?.addEventListener('click', closeContact);
      contactOverlay?.addEventListener('click', (e) => {
        if (e.target === contactOverlay) closeContact();
      });
      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape') closeContact();
      });

      // Info overlay
      const infoBtn = document.getElementById('nav-info-btn');
      const infoOverlay = document.getElementById('info-overlay');
      const infoClose = document.getElementById('info-close');
      function openInfo() {
        infoOverlay?.classList.add('open');
        document.body.style.overflow = 'hidden';
      }
      function closeInfo() {
        infoOverlay?.classList.remove('open');
        document.body.style.overflow = '';
      }
      if (infoBtn && infoOverlay) {
        infoBtn.addEventListener('click', openInfo);
        infoClose?.addEventListener('click', closeInfo);
        infoOverlay.addEventListener('click', (e) => {
          if (e.target === infoOverlay) closeInfo();
        });
        document.addEventListener('keydown', (e) => {
          if (e.key === 'Escape') closeInfo();
        });
      }
    </script>
  </body>
</html>

<style is:global>
  @font-face {
    font-family: 'Caslon Ionic';
    src: url('/fonts/CaslonIonic-Light-Trial.otf') format('opentype');
    font-weight: 300;
    font-style: normal;
    font-display: swap;
  }

  @font-face {
    font-family: 'Caslon Ionic';
    src: url('/fonts/CaslonIonic-LightItalic-Trial.otf') format('opentype');
    font-weight: 300;
    font-style: italic;
    font-display: swap;
  }

  @font-face {
    font-family: 'Caslon Ionic';
    src: url('/fonts/CaslonIonic-Regular-Trial.otf') format('opentype');
    font-weight: 400;
    font-style: normal;
    font-display: swap;
  }

  @font-face {
    font-family: 'Caslon Ionic';
    src: url('/fonts/CaslonIonic-RegularItalic-Trial.otf') format('opentype');
    font-weight: 400;
    font-style: italic;
    font-display: swap;
  }

  *, *::before, *::after {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
  }

  html {
    font-family: 'Helvetica Neue', Arial, sans-serif;
    font-weight: 400;
    font-size: 16px;
    background: #FAFAFA;
    color: #000000;
    -webkit-font-smoothing: antialiased;
  }

  body {
    min-height: 100vh;
    display: flex;
    flex-direction: column;
  }

  main {
    flex: 1;
  }

  a {
    color: #000000;
    text-decoration: none;
  }

  img {
    display: block;
    max-width: 100%;
  }

  /* ── NAV ── */
  nav {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    height: 50px;
    background: #FAFAFA;
    z-index: 100;
    display: flex;
    align-items: center;
  }

  .nav-logo {
    position: absolute;
    left: 20px;
    font-family: 'Helvetica Neue', Arial, sans-serif;
    font-size: 12px;
    font-weight: 700;
    color: #000;
    letter-spacing: 0.12px;
    text-decoration: none;
    text-transform: uppercase;
  }

  .nav-center {
    margin: 0 auto;
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .nav-link {
    font-family: 'Caslon Ionic', Georgia, serif;
    font-weight: 300;
    font-style: italic;
    font-size: 12px;
    color: #000;
    opacity: 0.33;
    letter-spacing: 0.36px;
    text-decoration: none;
    cursor: pointer;
    background: none;
    border: none;
    padding: 0;
  }

  .nav-link:hover {
    opacity: 1;
  }

  .nav-project-name {
    font-family: 'Helvetica Neue', Arial, sans-serif;
    font-size: 12px;
    font-weight: 700;
    color: #000;
    letter-spacing: 0.12px;
  }

  .nav-right {
    position: absolute;
    right: 20px;
    opacity: 0.33;
  }

  .nav-right:hover {
    opacity: 1;
  }

  /* ── FOOTER ── */
  footer {
    background: #FAFAFA;
    padding: 1.5rem;
    margin-top: auto;
    display: flex;
    flex-direction: column;
    gap: 2rem;
  }

  .footer-info {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  .footer-info p {
    font-size: 15px;
    font-weight: 400;
    letter-spacing: 0;
    line-height: 1.1;
    max-width: 40vw;
  }

  .footer-links {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  .footer-links a {
    font-size: 15px;
    font-weight: 400;
    letter-spacing: 0;
  }

  /* ── CONTACT OVERLAY ── */
  .contact-overlay {
    display: none;
    position: fixed;
    inset: 0;
    background: rgba(250, 250, 250, 0.50);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    z-index: 300;
    align-items: center;
    justify-content: center;
  }

  .contact-overlay.open {
    display: flex;
  }

  .contact-close {
    position: absolute;
    top: 20px;
    right: 20px;
    font-family: 'Helvetica Neue', Arial, sans-serif;
    font-size: 14px;
    font-weight: 400;
    color: #000;
    background: none;
    border: none;
    cursor: pointer;
    padding: 0;
    letter-spacing: 0.01em;
    line-height: 1.1;
  }

  .contact-close:hover {
    opacity: 0.5;
  }

  .contact-card {
    background: #fff;
    padding: 12px 12px 16px;
    display: flex;
    flex-direction: column;
    gap: 0;
    width: max-content;
  }

  .contact-item {
    display: flex;
    flex-direction: column;
    margin-bottom: 10px;
  }

  .contact-label {
    font-family: 'Caslon Ionic', Georgia, serif;
    font-style: italic;
    font-weight: 300;
    font-size: 11.8px;
    color: #000;
    letter-spacing: 0.355px;
    line-height: 1;
    margin-bottom: 1px;
  }

  .contact-value {
    font-family: 'Helvetica Neue', Arial, sans-serif;
    font-size: 14.8px;
    font-weight: 500;
    color: #000;
    text-decoration: none;
    letter-spacing: 0.01em;
    line-height: 1.1;
  }

  a.contact-value:hover {
    opacity: 0.5;
  }

  .contact-based {
    margin-top: 16px;
  }

  .contact-based .contact-value {
    display: block;
  }

  /* ── INFO OVERLAY ── */
  .info-overlay {
    display: none;
    position: fixed;
    inset: 0;
    background: rgba(250, 250, 250, 0.50);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    z-index: 200;
    align-items: center;
    justify-content: center;
  }

  .info-overlay.open {
    display: flex;
  }

  .info-close {
    position: absolute;
    top: 20px;
    right: 20px;
    font-family: 'Helvetica Neue', Arial, sans-serif;
    font-size: 14px;
    font-weight: 400;
    color: #000;
    background: none;
    border: none;
    cursor: pointer;
    padding: 0;
    letter-spacing: 0.01em;
  }

  .info-close:hover {
    opacity: 0.5;
  }

  .info-card {
    background: #fff;
    padding: 16px 14px 20px;
    display: flex;
    flex-direction: column;
    gap: 0;
    width: 220px;
  }

  .info-section {
    display: flex;
    flex-direction: column;
    margin-bottom: 14px;
  }

  .info-section:last-child {
    margin-bottom: 0;
  }

  .info-label {
    font-family: 'Caslon Ionic', Georgia, serif;
    font-style: italic;
    font-weight: 300;
    font-size: 11.8px;
    color: #000;
    letter-spacing: 0.355px;
    line-height: 1;
    margin-bottom: 2px;
    text-transform: none;
  }

  .info-value {
    font-family: 'Helvetica Neue', Arial, sans-serif;
    font-size: 13px;
    font-weight: 500;
    color: #000;
    letter-spacing: 0.01em;
    line-height: 1.3;
  }

  .info-value--pre {
    white-space: pre-line;
  }

  .info-empty {
    font-family: 'Helvetica Neue', Arial, sans-serif;
    font-size: 13px;
    color: #000;
    opacity: 0.33;
  }

  /* ── RESPONSIVE ── */
  @media (max-width: 768px) {
    nav {
      padding: 0 16px;
    }

    .nav-logo {
      left: 16px;
    }

    .nav-right {
      right: 16px;
    }

    footer {
      padding: 1rem 0.75rem;
    }

    .footer-info p {
      max-width: none;
    }
  }
</style>
